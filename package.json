{
	"name": "zovo-pagevault",
	"version": "1.0.0",
	"description": "Versioned local web-page archive built on SingleFile",
	"author": "Zovo; SingleFile contributors",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"dev": "./build-dev.sh",
		"build:upstream": "./build-extension.sh",
		"build": "npm run build:upstream && node zpv-tools/build.mjs",
		"test:upstream": "node test/editor-e2e.mjs",
		"test": "node --test test/zpv-*.test.mjs",
		"check": "npm test && node zpv-tools/check-build.mjs dist",
		"install-test-browser": "browsers install chrome@131.0.6778.204 --path test/.browser"
	},
	"type": "module",
	"dependencies": {
		"single-file-core": "1.5.118"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@puppeteer/browsers": "^3.2.1",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-terser": "1.0.0",
		"eslint": "^10.0.0",
		"rollup": "^4.57.1",
		"simple-cdp": "^1.10.1"
	},
	"overrides": {
		"terser": "^5.15.0"
	}
}
